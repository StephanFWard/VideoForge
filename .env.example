# ============================================================================
#  VideoForge — environment configuration
#  Copy to `.env` (or just export these) and edit.  Every value is optional.
# ============================================================================

# --- Render backend ---------------------------------------------------------
# auto  = probe ComfyUI, then LTX-Video, fall back to the offline mock renderer
# comfy = require ComfyUI (fail loudly if it is down)
# ltx   = require the local LTX-Video MCP server (npm run setup:ltx)
# mock  = never touch ComfyUI; render placeholder frames locally (great for CI)
VIDEO_FORGE_BACKEND=auto

# --- ComfyUI ----------------------------------------------------------------
# Point this at your ComfyUI instance.  Anything that speaks the ComfyUI HTTP
# API works, including a free Google Colab GPU reached through a tunnel:
#   COMFYUI_URL=https://your-random-words.trycloudflare.com
COMFYUI_URL=http://127.0.0.1:8188

# Optional: swap the ComfyUI MCP server command (defaults to the published one)
# COMFYUI_MCP_COMMAND=npx
# COMFYUI_MCP_ARGS=-y comfyui-mcp@latest --comfyui-url http://127.0.0.1:8188

# --- Kokoro (narration) -----------------------------------------------------
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# One of: en-us en-gb es fr hi it pt-br ja zh
KOKORO_LANG=en-us

# Optional: use a third-party Kokoro MCP server instead of the bundled one.
# Any server exposing a TTS tool will be auto-detected.
# KOKORO_MCP_COMMAND=uv
# KOKORO_MCP_ARGS=--directory C:/path/to/kokoro-tts-mcp run mcp-tts.py

# --- LTX-Video (local video diffusion) --------------------------------------
# Installed into its own .venv-ltx by `npm run setup:ltx`. This is the backend
# that conditions renders on uploaded reference images/videos.
# LTX_MODEL=ltxv-2b-0.9.8-distilled.yaml
# LTX_OFFLOAD_TO_CPU=0
# VIDEO_FORGE_MAX_REFERENCES=8

# --- Layered video editing --------------------------------------------------
# Optional override; `npm run setup:matting` creates the default .venv-matting.
# VIDEO_FORGE_MATTING_PYTHON=C:/path/to/python.exe

# --- Output -----------------------------------------------------------------
# RESOLUTION=4k          # 4k | 1080p | 720p
# VIDEO_FORGE_OUT=./output
# VIDEO_FORGE_WORK=./work

# --- Optional model access --------------------------------------------------
# Only needed to pull gated weights (e.g. FLUX) on first use.
# HF_TOKEN=hf_xxx
